meta {
  name: List shipments
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/shipments?limit=10&status=draft
  body: none
  auth: inherit
}

params:query {
  limit: 10
  status: draft
}

assert {
  res.status: eq 200
  res.headers['content-type']: contains application/json
  res.body.data: isArray
  res.body.has_more: isBoolean
  res.body.data[0].status: in draft,dispatched,in_transit,out_for_delivery,delivered,exception,cancelled
}

tests {
  test("every shipment has an id with the shp_ prefix", function () {
    res.getBody().data.forEach((s) => expect(s.id).to.match(/^shp_[A-Za-z0-9]{8,}$/));
  });
}

docs {
  `listShipments` with the `status` filter. Prism does not filter; the
  assertion only checks the value is a valid `ShipmentStatus`.
}
