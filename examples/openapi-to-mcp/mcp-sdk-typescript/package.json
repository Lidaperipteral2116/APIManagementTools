{
  "name": "parcelio-mcp-handwritten",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hand-written MCP stdio server with three tools against the Parcelio Shipments API",
  "engines": { "node": ">=22" },
  "scripts": {
